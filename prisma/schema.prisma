generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id
  name          String
  email         String         @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  role          UserRole       @default(USER)
  accounts      Account[]
  memberships   Member[]
  profile       Profile?
  sessions      Session[]
  tourProgress  TourProgress[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model Organization {
  id                String           @id @default(cuid())
  name              String           @unique
  slug              String           @unique
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  billingStatus     BillingStatus    @default(ACTIVE)
  workOnHolidays    Boolean          @default(false)
  gracePeriodEnd    DateTime?
  lastPaymentDate   DateTime?
  mpCustomerId      String?          @unique
  mpSubscriptionId  String?          @unique
  subscriptionPlan  SubscriptionPlan @default(BASIC)
  phone             String?
  whatsapp             String?
  slotGenerationMethod SlotGenerationMethod @default(SERVICE_DURATION)
  invitations          Invitation[]
  locations         Location[]
  members           Member[]
  profiles          Profile[]

  @@map("organization")
}

model Location {
  id             String                  @id @default(cuid())
  organizationId String
  name           String
  address        String?
  city           String?
  phone          String?
  isActive       Boolean                 @default(true)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  appointments   Appointment[]
  availabilities Availability[]
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberServices MemberLocationService[]

  @@unique([organizationId, name])
  @@map("location")
}

model Member {
  id               String                  @id @default(cuid())
  userId           String
  organizationId   String
  role             MemberRole              @default(PROFESSIONAL)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  locationServices MemberLocationService[]

  @@unique([userId, organizationId])
  @@map("member")
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  email          String?
  token          String       @unique
  role           MemberRole   @default(PROFESSIONAL)
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("invitation")
}

model Profile {
  id                 String         @id @default(cuid())
  userId             String         @unique
  username           String         @unique
  bio                String?
  googleCalendarId   String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  displayName        String?
  organizationId     String?
  showOnOrgPage      Boolean        @default(true)
  advanceNoticeHours Int            @default(24)
  expertise          String[]       @default([])
  syncToken          String?
  webhookChannelId   String?        @unique
  webhookExpiresAt   DateTime?
  webhookResourceId  String?
  bufferTime         Int            @default(0)
  appointments       Appointment[]
  availabilities     Availability[]
  organization       Organization?  @relation(fields: [organizationId], references: [id])
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  services           Service[]

  @@map("profile")
}

model MemberLocationService {
  id         String   @id @default(cuid())
  memberId   String
  locationId String
  serviceId  String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([memberId, locationId, serviceId])
  @@map("member_location_service")
}

model Service {
  id               String                  @id @default(cuid())
  profileId        String
  name             String
  durationMinutes  Int                     @default(30)
  isActive         Boolean                 @default(true)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  price            Float?                  @default(0)
  appointments     Appointment[]
  locationServices MemberLocationService[]
  profile          Profile                 @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, name])
  @@map("service")
}

model Availability {
  id           String    @id @default(cuid())
  profileId    String
  dayOfWeek    Int?
  specificDate DateTime?
  startTime    String
  endTime      String
  isBlocked    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  locationId   String?
  location     Location? @relation(fields: [locationId], references: [id])
  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, specificDate, startTime, endTime])
  @@map("availability")
}

model Appointment {
  id                String    @id @default(cuid())
  profileId         String
  clientName        String
  clientEmail       String?
  clientPhone       String
  startTime         DateTime
  endTime           DateTime
  status            String    @default("PENDING")
  googleEventId     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  serviceId         String?
  cancelToken       String?   @unique
  notes             String?
  reminder24hSentAt DateTime?
  reminder2hSentAt  DateTime?
  locationId        String?
  paymentReference  String?   @unique
  location          Location? @relation(fields: [locationId], references: [id])
  profile           Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  service           Service?  @relation(fields: [serviceId], references: [id])

  @@index([profileId, startTime, endTime])
  @@map("appointment")
}

model SystemConfig {
  id                      String   @id @default("global")
  maintenanceMode         Boolean  @default(false)
  announcementTitle       String?
  announcementBody        String?
  announcementType        String   @default("INFO")
  updatedAt               DateTime @updatedAt

  @@map("system_config")
}

model PlanConfig {
  name         String
  price        String
  limit        String
  features     String[]         @default([])
  active       Boolean          @default(true)
  updatedAt    DateTime         @updatedAt
  maxSeats     Int              @default(0)
  id           SubscriptionPlan @id
  maxLocations Int              @default(1)

  @@map("plan_config")
}

model TourProgress {
  id          String   @id @default(cuid())
  userId      String
  pageKey     String
  completedAt DateTime @default(now())
  tourVersion DateTime
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, pageKey])
  @@map("tour_progress")
}

enum UserRole {
  USER
  ADMIN
}

enum SubscriptionPlan {
  BASIC
  TEAM
  CORPORATE
}

enum SlotGenerationMethod {
  SERVICE_DURATION
  FIXED_30_MIN
}

enum BillingStatus {
  ACTIVE
  OVERDUE
  DEGRADED
}

enum MemberRole {
  OWNER
  MANAGER
  PROFESSIONAL
}
