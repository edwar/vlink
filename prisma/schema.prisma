// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Better-Auth Core Models
model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  profile       Profile?

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

// VLink Project Specific Models

model Profile {
  id               String         @id @default(cuid())
  userId           String         @unique
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  username         String         @unique
  bio              String?
  displayName      String?
  googleCalendarId String? // For syncing
  availabilities   Availability[]
  appointments     Appointment[]
  services         Service[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@map("profile")
}

model Service {
  id              String        @id @default(cuid())
  profileId       String
  profile         Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name            String
  durationMinutes Int           @default(30)
  isActive        Boolean       @default(true)
  appointments    Appointment[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("service")
}

model Availability {
  id           String    @id @default(cuid())
  profileId    String
  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  dayOfWeek    Int? // 0-6 (Sunday-Saturday) for recurring
  specificDate DateTime? // For one-time blocks or overrides
  startTime    String // "HH:mm"
  endTime      String // "HH:mm"
  isBlocked    Boolean   @default(false) // true for holidays/vacations/medical
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("availability")
}

model Appointment {
  id            String   @id @default(cuid())
  profileId     String
  profile       Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  serviceId     String?
  service       Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  clientName    String
  clientEmail   String?
  clientPhone   String // WhatsApp
  startTime     DateTime
  endTime       DateTime
  status        String   @default("PENDING") // PENDING, CONFIRMED, CANCELLED
  googleEventId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("appointment")
}
