// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Better-Auth Core Models
model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  role          UserRole  @default(USER)
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  profile       Profile?
  memberships   Member[]

  @@map("user")
}

enum UserRole {
  USER
  ADMIN
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

// VLink Project Specific Models

enum SubscriptionPlan {
  FREE
  TEAM
  CORPORATE
}

enum BillingStatus {
  ACTIVE
  OVERDUE
  DEGRADED
}

model Organization {
  id               String           @id @default(cuid())
  name             String           @unique
  slug             String           @unique
  subscriptionPlan SubscriptionPlan @default(FREE)
  billingStatus    BillingStatus    @default(ACTIVE)
  lastPaymentDate  DateTime?
  gracePeriodEnd   DateTime?
  mpCustomerId     String?          @unique
  mpSubscriptionId String?          @unique
  members          Member[]
  profiles         Profile[] // Perfiles profesionales en esta organizacion
  invitations      Invitation[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@map("organization")
}

model Member {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           MemberRole   @default(PROFESSIONAL)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, organizationId])
  @@map("member")
}

enum MemberRole {
  OWNER
  MANAGER
  PROFESSIONAL
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String? // Opcional: invitar por email específico
  token          String       @unique
  role           MemberRole   @default(PROFESSIONAL)
  expiresAt      DateTime
  createdAt      DateTime     @default(now())

  @@map("invitation")
}

model Profile {
  id                 String         @id @default(cuid())
  userId             String         @unique
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId     String?
  organization       Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  username           String         @unique
  bio                String?
  displayName        String?
  googleCalendarId   String? // For syncing
  syncToken          String? // Google Calendar sync token for incremental updates
  webhookChannelId   String?        @unique // Google Calendar watch channel ID
  webhookResourceId  String? // Google Calendar watch resource ID
  webhookExpiresAt   DateTime? // When the watch channel expires
  availabilities     Availability[]
  appointments       Appointment[]
  services           Service[]
  showOnOrgPage      Boolean        @default(true)
  advanceNoticeHours Int            @default(24)
  expertise          String[]       @default([])
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@map("profile")
}

model Service {
  id              String        @id @default(cuid())
  profileId       String
  profile         Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name            String
  durationMinutes Int           @default(30)
  isActive        Boolean       @default(true)
  appointments    Appointment[]
  price           Float?        @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("service")
}

model Availability {
  id           String    @id @default(cuid())
  profileId    String
  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  dayOfWeek    Int? // 0-6 (Sunday-Saturday) for recurring
  specificDate DateTime? // For one-time blocks or overrides
  startTime    String // "HH:mm"
  endTime      String // "HH:mm"
  isBlocked    Boolean   @default(false) // true for holidays/vacations/medical
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("availability")
}

model Appointment {
  id                String    @id @default(cuid())
  profileId         String
  profile           Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  serviceId         String?
  service           Service?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  clientName        String
  clientEmail       String?
  clientPhone       String // WhatsApp
  startTime         DateTime
  endTime           DateTime
  status            String    @default("PENDING") // PENDING, CONFIRMED, CANCELLED
  googleEventId     String?
  cancelToken       String?   @unique // Unique token for client self-cancellation link
  notes             String?   @db.Text // Internal notes visible only to the professional
  reminder24hSentAt DateTime? // Timestamp when 24h reminder was sent (null = not yet sent)
  reminder2hSentAt  DateTime? // Timestamp when 2h reminder was sent (null = not yet sent)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("appointment")
}

model SystemConfig {
  id                String   @id @default("global")
  maintenanceMode   Boolean  @default(false)
  announcementTitle String?
  announcementBody  String?
  announcementType  String   @default("INFO") // INFO, WARNING, SUCCESS
  updatedAt         DateTime @updatedAt

  @@map("system_config")
}

model PlanConfig {
  id        SubscriptionPlan @id
  name      String
  price     String
  limit     String
  maxSeats  Int              @default(0) // 0 for unlimited, or specific seat count
  features  String[]         @default([])
  active    Boolean          @default(true)
  updatedAt DateTime         @updatedAt

  @@map("plan_config")
}
